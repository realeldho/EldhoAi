# Template for EldhoAi local configuration.
# Source run: copy this file to .env in the repository root.
# Installed app: create %LOCALAPPDATA%\EldhoAi\.env instead.
# Replace the placeholders with YOUR keys. Never commit the real .env file.

# Required for NVIDIA AI chat, vision, and hosted speech recognition.
NVIDIA_API_KEY=paste_your_own_nvidia_key_here

# Required for Tavily web search.
TAVILY_API_KEY=paste_your_own_tavily_key_here

# Optional override for NVIDIA hosted Riva ASR. The application has a default.
NVIDIA_ASR_FUNCTION_ID=d3fe9151-442b-4204-a70d-5fcc597fd610

# Chat model selection is managed inside EldhoAi > Settings > AI Model.
# Do not add a model variable here; the current application does not read one.
